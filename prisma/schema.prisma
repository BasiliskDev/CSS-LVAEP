// Tutor Attendance & Achievement tracker.
// Replaces the LVA Essex/Passaic paper form: one sheet per student per fiscal year.
//
// Role/status columns are plain Strings backed by the union types + Zod enums in
// src/lib/constants.ts, rather than native enums: the app validates them in one
// place already, and adding a value stays a code change instead of a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A tutor account. Doubles as the profile block at the top of the paper form.
model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
  displayName  String
  role         String @default("TUTOR") // TUTOR | ADMIN

  // Profile, collected during onboarding.
  phone        String?
  siteId       String?
  defaultDays  String?
  defaultTimes String?
  onboardedAt  DateTime?

  /// Where an invite was sent. Nullable because the seeded office account predates
  /// invites; unique so two accounts can never claim the same address (Postgres treats
  /// NULLs as distinct, so any number of accounts may have none).
  email String? @unique

  site              Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  sessions          Session[]
  students          Student[]
  invitesSent       Invite[]
  scheduledSessions ScheduledSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

/// An opaque login session. The token is what lives in the `session` cookie.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A tutoring location, e.g. Bloomfield Public Library.
model Site {
  id      String  @id @default(cuid())
  name    String  @unique
  address String?

  users             User[]
  students          Student[]
  invites           Invite[]
  scheduledSessions ScheduledSession[]

  createdAt DateTime @default(now())
}

/// The "container" a tutor works in: one student, one fiscal year.
model Student {
  id String @id @default(cuid())

  /// Null while the student sits in the office's unassigned pool — either a tutor handed
  /// them back, or their tutor's account was deleted. The record and every lesson,
  /// achievement and report survive, so the office can reassign without losing a thing.
  tutorId   String?
  firstName String
  lastName  String

  siteId String?
  days   String?
  times  String?

  /// Calendar year of the July that opens this student's fiscal year (2026 => FY 2026-2027).
  fiscalYearStart Int

  status        String    @default("ACTIVE") // ACTIVE | STOPPED
  stoppedAt     DateTime?
  stoppedReason String?

  notes String?

  /// Set when a tutor removes the student from their caseload. Irreversible for them;
  /// only the office can reassign.
  removedAt     DateTime?
  removedReason String?
  /// Deliberately FK-free: the office only ever reads these back as display text, and a
  /// second relation to User would force naming the `tutor` relation on both sides.
  removedById   String?
  removedByName String?

  /// SetNull, not Cascade: deleting a tutor must park their students in the office pool,
  /// never destroy a year of logged hours.
  tutor             User?                     @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  site              Site?                     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  lessons           Lesson[]
  achievements      StudentAchievement[]
  reports           Report[]
  scheduledSessions ScheduledSessionStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorId, status])
  @@index([siteId])
}

/// One tutoring session. Several on the same day are legal; the grid cell sums them.
model Lesson {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime

  /// Time slot as "HH:MM" (24h), the way tutors actually record a session.
  /// Null for absences, and for events logged before time slots existed.
  startTime String?
  endTime   String?

  /// Derived from the time slot on save, and the single source for every total.
  /// Kept as a stored column so totals stay cheap and legacy rows keep working.
  hours  Float  @default(0)
  status String @default("HELD") // HELD | TUTOR_ABSENT | STUDENT_ABSENT | HOLIDAY

  topics            String?
  homeworkAssigned  Boolean @default(false)
  homeworkCompleted Boolean @default(false)
  notes             String?

  /// The series this event was logged from, when it came through the session form.
  /// Null for anything logged by hand, which is every row that predates scheduling.
  scheduledSessionId String?

  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// SetNull: deleting a series must never delete logged hours.
  scheduledSession ScheduledSession? @relation(fields: [scheduledSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One event per student per occurrence, so re-submitting the session form updates
  /// instead of duplicating. Postgres treats NULLs as distinct, so this binds only rows
  /// that came from a series — hand-logged events on the same day stay legal.
  @@unique([scheduledSessionId, studentId, date])
  @@index([studentId, date])
  @@index([scheduledSessionId, date])
}

/// Checklist state for one goal. Labels for A1-D4 come from the static catalog in
/// src/lib/achievements.ts; only custom "E. Other(s)" rows store their own label.
model StudentAchievement {
  id         String    @id @default(cuid())
  studentId  String
  code       String
  label      String?
  attained   Boolean   @default(false)
  attainedAt DateTime?
  note       String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, code])
}

/// A free-form write-up about a student. The paper form had no room for these.
model Report {
  id          String    @id @default(cuid())
  studentId   String
  title       String
  periodStart DateTime?
  periodEnd   DateTime?
  body        String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

/// An invitation to create an account. Accounts are created only this way.
model Invite {
  id    String @id @default(cuid())
  email String

  /// Opaque, 32 random bytes hex — the same construction as Session.token, and stored
  /// raw for the same reason the link has to keep working: the office needs to be able
  /// to re-copy it days later when the email didn't arrive.
  token       String  @unique
  displayName String
  role        String  @default("TUTOR") // TUTOR | ADMIN
  siteId      String?

  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  /// Delivery is best-effort — without a verified sender domain it often won't reach an
  /// external inbox at all — so the outcome is recorded and the office falls back to the
  /// copyable link. A failed send must never lose the invite.
  emailSentAt DateTime?
  emailError  String?

  invitedBy User  @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  site      Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([invitedById])
}

/// A recurring weekly tutoring session, scheduled by the office: one tutor, one or more
/// weekdays, one time slot, one date range, a set of students.
///
/// Occurrences are computed from this rule by src/lib/recurrence.ts and never stored.
/// Materialising them would make every edit to the series a reconciliation problem, and
/// an occurrence's identity is already derivable from (id, date).
model ScheduledSession {
  id      String  @id @default(cuid())
  tutorId String
  siteId  String?
  title   String?

  /// Which days of the week it repeats on: 0 = Sunday … 6 = Saturday, matching
  /// Date#getUTCDay() and WEEKDAY_LABELS. At least one, ascending and distinct —
  /// src/lib/recurrence.ts normalises on the way in and tolerates neither being true.
  weekdays  Int[]
  /// The club's wall clock as "HH:MM", exactly like Lesson.startTime/endTime.
  startTime String
  endTime   String
  /// Both UTC midnight, both inclusive. `endsOn` is always the real last date, even when
  /// the office entered a number of meetings instead — the count is resolved to a date
  /// before it is stored, so every range query and index here works on two columns.
  startsOn  DateTime
  endsOn    DateTime

  /// Which control the office used to end the series: ON_DATE | AFTER_COUNT. Purely a
  /// record of intent, so editing a series reopens the form the way they filled it in.
  endMode         String @default("ON_DATE")
  /// The number of meetings they asked for, when endMode is AFTER_COUNT. Null otherwise.
  /// Not authoritative: cancelling a date leaves the count as the office's *intent*
  /// while `endsOn` stays put, which is how Google Calendar behaves too.
  occurrenceCount Int?

  status String  @default("ACTIVE") // ACTIVE | ARCHIVED
  notes  String?

  tutor    User                      @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  site     Site?                     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  students ScheduledSessionStudent[]
  skips    ScheduledSessionSkip[]
  lessons  Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorId, status])
  @@index([status, startsOn, endsOn])
}

/// Which students the tutor is responsible for in a given session.
model ScheduledSessionStudent {
  id                 String @id @default(cuid())
  scheduledSessionId String
  studentId          String

  scheduledSession ScheduledSession @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([scheduledSessionId, studentId])
  @@index([studentId])
}

/// One cancelled occurrence — a holiday, a closure. The series itself survives.
model ScheduledSessionSkip {
  id                 String @id @default(cuid())
  scheduledSessionId String

  /// UTC midnight of the cancelled occurrence.
  date   DateTime
  reason String?

  scheduledSession ScheduledSession @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([scheduledSessionId, date])
}
