# Postgres connection string.
#
# Local development: point this at any Postgres you can reach — a local install,
# a Docker container, or simply your hosted development database.
#   docker run -d --name tutorlog-db -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=tutorlog postgres:16
#
# Production (Vercel): use the POOLED connection string your provider gives you.
# Serverless opens a connection per instance, so an unpooled endpoint will hit the
# database's connection limit under load.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutorlog"

# Optional but recommended on Vercel/Neon: the DIRECT (unpooled) connection string.
# Only the Prisma CLI uses it, for migrations — DDL through a transaction-mode pooler
# is unreliable. The app itself always uses the pooled DATABASE_URL above.
# DIRECT_URL="postgresql://...@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Optional. Connections per instance (default 3). Keep it small on serverless.
# DATABASE_POOL_MAX="3"

# Credentials the seed script gives the office/admin account.
# Change the password after the first login.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme123"
